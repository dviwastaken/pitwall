<Window x:Class="PitWall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PitWall"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="PitWall — iRacing Telemetri" Height="760" Width="1100"
        MinHeight="560" MinWidth="640"
        Background="#0D0D0D"
        Closing="MainWindow_OnClosing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel Background="{TemplateBinding Background}">
                            <TabPanel x:Name="HeaderPanel" DockPanel.Dock="Top" IsItemsHost="True"
                                      Background="Transparent" HorizontalAlignment="Left"/>
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#C3C2B7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4,8"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="HeaderBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}" HorizontalAlignment="Left">
                            <TextBlock x:Name="ContentSite" Text="{TemplateBinding Header}"
                                       Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#3987E5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinimalScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#3A3A38" CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="1,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MinimalScrollBarThumb}" Width="6"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Margin="0,1">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource MinimalScrollBarThumb}" Height="6"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1B1B1A"/>
            <Setter Property="Foreground" Value="#C3C2B7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderBrush" Value="#2C2C2A"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="DarkCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#22344D"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#161615"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#C3C2B7"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="ChartPanel" TargetType="Border">
            <Setter Property="Background" Value="#161615"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Status bar -->
        <Border DockPanel.Dock="Top" Background="#161615" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#E66767" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TrackName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text=" · " Foreground="#C3C2B7" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CarName}" FontSize="13" Foreground="#C3C2B7" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Background="Transparent" BorderThickness="0">
            <TabItem Header="Canlı Telemetri">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">
                        <WrapPanel>
                            <Border Style="{StaticResource CardBorder}" Width="120">
                                <StackPanel>
                                    <TextBlock Text="HIZ (km/s)" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Text="{Binding SpeedText}" Style="{StaticResource CardValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Width="120">
                                <StackPanel>
                                    <TextBlock Text="DEVİR (RPM)" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Text="{Binding RpmText}" Style="{StaticResource CardValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Width="90">
                                <StackPanel>
                                    <TextBlock Text="VİTES" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Text="{Binding GearText}" Style="{StaticResource CardValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Width="100">
                                <StackPanel>
                                    <TextBlock Text="YAKIT" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Text="{Binding FuelText}" Style="{StaticResource CardValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Width="150">
                                <StackPanel>
                                    <TextBlock Text="ANLIK TUR" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Text="{Binding CurrentLapTimeText}" Style="{StaticResource CardValue}" FontSize="20"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Width="150">
                                <StackPanel>
                                    <TextBlock Text="SON TUR" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Text="{Binding LastLapTimeText}" Style="{StaticResource CardValue}" FontSize="20"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Width="150">
                                <StackPanel>
                                    <TextBlock Text="EN İYİ TUR" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Text="{Binding BestLapTimeText}" Style="{StaticResource CardValue}" FontSize="20" Foreground="#199E70"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <Border Style="{StaticResource ChartPanel}" Height="180">
                            <StackPanel>
                                <TextBlock Text="Gaz / Fren (%)" Style="{StaticResource CardLabel}" Margin="0,0,0,4"/>
                                <lvc:CartesianChart Series="{Binding ThrottleBrakeSeries}" XAxes="{Binding TimeAxis}" YAxes="{Binding PercentAxis}"
                                                     Background="Transparent" TooltipPosition="Hidden"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ChartPanel}" Height="150">
                            <StackPanel>
                                <TextBlock Text="Direksiyon Torku (Nm)" Style="{StaticResource CardLabel}" Margin="0,0,0,4"/>
                                <lvc:CartesianChart Series="{Binding SteeringSeries}" XAxes="{Binding TimeAxis}" YAxes="{Binding TorqueAxis}"
                                                     Background="Transparent" TooltipPosition="Hidden"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ChartPanel}" Height="150">
                            <StackPanel>
                                <TextBlock Text="Hız (km/s)" Style="{StaticResource CardLabel}" Margin="0,0,0,4"/>
                                <lvc:CartesianChart Series="{Binding SpeedSeries}" XAxes="{Binding TimeAxis}" YAxes="{Binding SpeedAxis}"
                                                     Background="Transparent" TooltipPosition="Hidden"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Tur Karşılaştırma">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock DockPanel.Dock="Top" Text="Kayıtlı turlar (Ctrl+tık ile 2 tur seçin)" Style="{StaticResource CardLabel}" Margin="0,0,0,6"/>
                        <Button DockPanel.Dock="Bottom" x:Name="CompareButton" Content="Karşılaştır" Margin="0,10,0,0"
                                Padding="10,6" Background="#3987E5" Foreground="White" BorderThickness="0"
                                Click="CompareButton_OnClick"/>
                        <DataGrid x:Name="LapsDataGrid" ItemsSource="{Binding Laps}" AutoGenerateColumns="False"
                                  SelectionMode="Extended" IsReadOnly="True" Background="#161615" Foreground="White"
                                  RowBackground="#161615" AlternatingRowBackground="#1B1B1A" BorderThickness="0"
                                  GridLinesVisibility="None" HeadersVisibility="Column" RowHeaderWidth="0"
                                  ColumnHeaderStyle="{StaticResource DarkColumnHeaderStyle}"
                                  CellStyle="{StaticResource DarkCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tur" Binding="{Binding LapNumber}" Width="45"/>
                                <DataGridTextColumn Header="Pist" Binding="{Binding TrackName}" Width="*"/>
                                <DataGridTextColumn Header="Süre" Binding="{Binding LapTimeSeconds, StringFormat={}{0:F3}}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ComparisonInfoText}"
                                   Style="{StaticResource CardLabel}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource ChartPanel}">
                            <lvc:CartesianChart Series="{Binding ComparisonSeries}" XAxes="{Binding ComparisonXAxes}" YAxes="{Binding ComparisonYAxes}"
                                                 Background="Transparent"/>
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
